{
  "name": "@deepseek-ai/dsh-pixies-app",
  "productName": "Pixies",
  "description": "Pixies menu-bar tray client (Electron shell): tray entry, global shortcut, and a frameless top-right window over the dsh backend (dev-run)",
  "version": "0.1.3-alpha.2",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && tsdown",
    "build:speech": "mkdir -p lib && swiftc -O -swift-version 5 speech/PixiesSpeech.swift -o lib/pixies-speech",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --skip-build",
    "package:mac": "tsx scripts/package-mac.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
